{
	"schemaVersion": 1,
	"id": "leafs",
	"version": "${version}",
	"name": "Leafs",
	"description": "Regionised multithreading for the dedicated server: the world is cut into independent regions, each ticking in parallel on its own thread - like Folia, redesigned for modern vanilla and Fabric.",
	"authors": [
		"Hardel"
	],
	"license": "All-Rights-Reserved",
	"icon": "assets/leafs/icon.png",
	"accessWidener": "leafs.accesswidener",
	"environment": "*",
	"entrypoints": {
		"main": [
			"fr.hardel.leafs.Leafs"
		]
	},
	"mixins": [
		"leafs.mixins.json"
	],
	"breaks": {
		"c2me": "*",
		"moonrise": "*",
		"vmp": "*"
	},
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*"
	},
	"custom": {
		"lithium:options": {
			"mixin.ai.poi": false,
			"mixin.alloc.chunk_random": false,
			"mixin.alloc.nbt": false,
			"mixin.chunk.no_locking": false,
			"mixin.chunk.palette": false,
			"mixin.util.chunk_status_tracking": false,
			"mixin.util.section_data_storage": false,
			"mixin.util.data_storage": false,
			"mixin.world.chunk_ticking.random_block_ticking": false
		}
	}
}
